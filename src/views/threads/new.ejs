<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <a href="/projects/<%= project.id %>" class="back-link">← Back to <%= project.name %></a>
    <h1>New Discussion Thread</h1>
  </div>
</div>

<div class="form-page">
  <form action="/projects/<%= project.id %>/threads" method="POST" class="project-form">
    <div class="form-group">
      <label for="title">Thread Title <span class="required">*</span></label>
      <input type="text" id="title" name="title" required minlength="2" maxlength="150"
        placeholder="What would you like to discuss?" autofocus />
    </div>
    <div class="form-actions">
      <a href="/projects/<%= project.id %>" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Create Thread</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
