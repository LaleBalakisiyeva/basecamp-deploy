<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <a href="/projects/<%= project.id %>/threads/<%= thread.id %>" class="back-link">← Back to Thread</a>
    <h1>Edit Thread</h1>
  </div>
</div>

<div class="form-page">
  <form action="/projects/<%= project.id %>/threads/<%= thread.id %>?_method=PUT" method="POST" class="project-form">
    <div class="form-group">
      <label for="title">Thread Title <span class="required">*</span></label>
      <input type="text" id="title" name="title" required minlength="2" maxlength="150" value="<%= thread.title %>" />
    </div>
    <div class="form-actions">
      <a href="/projects/<%= project.id %>/threads/<%= thread.id %>" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
