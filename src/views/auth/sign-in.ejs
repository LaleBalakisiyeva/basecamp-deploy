<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-header">
      <div class="auth-icon">⛺</div>
      <h1>Welcome back</h1>
      <p>Sign in to continue to your projects</p>
    </div>

    <form action="/auth/sign-in" method="POST" class="auth-form">
      <div class="form-group">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" autocomplete="email" />
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required placeholder="Your password" autocomplete="current-password" />
      </div>

      <button type="submit" class="btn btn-primary btn-full">Sign in</button>
    </form>

    <div class="auth-footer">
      Don't have an account? <a href="/auth/register">Create one</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
