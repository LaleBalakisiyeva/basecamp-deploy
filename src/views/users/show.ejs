<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1>
      <span class="avatar avatar--lg"><%= user.username.charAt(0).toUpperCase() %></span>
      <%= user.username %>
    </h1>
    <p class="page-meta">
      <%= user.email %>
      <% if (user.isAdmin) { %><span class="badge badge--admin">Admin</span><% } %>
    </p>
    <p class="page-meta">Member since <%= new Date(user.createdAt).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) %></p>
  </div>
  <% if (currentUserId === user.id) { %>
    <form action="/users/<%= user.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete your account? This is permanent and will remove all your projects.')">
      <button type="submit" class="btn btn-danger">Delete Account</button>
    </form>
  <% } %>
</div>

<div class="section">
  <h2>Projects (<%= user.projects.length %>)</h2>
  <% if (user.projects.length === 0) { %>
    <p class="text-muted">No projects yet.</p>
  <% } else { %>
    <div class="projects-grid projects-grid--compact">
      <% user.projects.forEach(project => { %>
        <a href="/projects/<%= project.id %>" class="project-card project-card--sm" style="--project-color: <%= project.color %>">
          <div class="project-color-bar"></div>
          <div class="project-card-body">
            <h3 class="project-name"><%= project.name %></h3>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
