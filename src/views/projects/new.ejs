<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <a href="/projects" class="back-link">← Back to Projects</a>
    <h1>New Project</h1>
  </div>
</div>

<div class="form-page">
  <form action="/projects" method="POST" class="project-form">
    <div class="form-group">
      <label for="name">Project Name <span class="required">*</span></label>
      <input type="text" id="name" name="name" required minlength="2" maxlength="100" placeholder="e.g. Website Redesign" autofocus />
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4" placeholder="What is this project about? (optional)"></textarea>
    </div>



    <div class="form-actions">
      <a href="/projects" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Create Project</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
