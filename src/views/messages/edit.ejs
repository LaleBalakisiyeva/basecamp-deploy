<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <a href="/projects/<%= project.id %>/threads/<%= threadId %>" class="back-link">← Back to Thread</a>
    <h1>Edit Message</h1>
  </div>
</div>

<div class="form-page">
  <form action="/projects/<%= project.id %>/threads/<%= threadId %>/messages/<%= message.id %>?_method=PUT" method="POST">
    <div class="form-group">
      <label for="body">Message <span class="required">*</span></label>
      <textarea id="body" name="body" rows="5" required><%= message.body %></textarea>
    </div>
    <div class="form-actions">
      <a href="/projects/<%= project.id %>/threads/<%= threadId %>" class="btn btn-ghost">Cancel</a>
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
